cabal-version:      3.0
name:               noided-web
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Anthony Super
maintainer:         anthony@noided.media
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

common deps
    build-depends:
       base >=4.18 && <=4.20,
       text,
       time,
       containers,
       optics-core,
       effectful-core,
       aeson

common exts
    default-extensions:
       DataKinds
       DerivingStrategies
       DuplicateRecordFields
       LambdaCase
       OverloadedRecordDot
       OverloadedStrings
       TypeFamilies

library
    import:           warnings, deps, exts
    exposed-modules:
      Noided.Web

      Noided.Web.Internal.Effect.CurrentTime
      Noided.Web.Internal.Effect.TimeEvent
      Noided.Web.Internal.Effect.Log

    hs-source-dirs:   lib
    default-language: GHC2021

test-suite noided-web-test
    import:           warnings, deps, exts
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        noided-web
