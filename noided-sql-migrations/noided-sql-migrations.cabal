cabal-version:      3.0
name:               noided-sql-migrations
version:            0.1.0.0
synopsis:           SQL migration support for noided-sql
license:            BSD-3-Clause
author:             Anthony Super
maintainer:         anthony@noided.media
category:           Database
build-type:         Simple

common warnings
    ghc-options: -Wall

common deps
    build-depends:
        base >=4.18 && <=5,
        text,
        containers,
        directory,
        filepath,
        hasql >= 2.0 && < 2.1

library
    import:           warnings, deps
    exposed-modules:
        Noided.Sql.Migration
        Noided.Sql.Migration.Internal
    build-depends:
        mtl,
        vector
    hs-source-dirs:   lib
    default-language: GHC2021

executable noided-migrate
    import:           warnings, deps
    main-is:          Main.hs
    build-depends:
        pqi-ffi >= 1.0 && < 1.1,
        noided-sql-migrations,
        optparse-applicative,
        time,
        process
    hs-source-dirs:   app
    default-language: GHC2021
