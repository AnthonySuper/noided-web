cabal-version:      3.0
name:               noided-sql-migrations
version:            0.1.0.0
synopsis:           SQL migration support for noided-sql
license:            BSD-3-Clause
author:             Anthony Super
maintainer:         anthony@noided.media
category:           Database
build-type:         Simple

common warnings
    ghc-options: -Wall

common deps
    build-depends:
        base >=4.18 && <=4.20,
        text,
        bytestring,
        directory,
        filepath,
        time,
        hasql >= 1.10 && < 1.11,
        noided-sql,
        mtl,
        transformers,
        containers,
        vector,
        process

library
    import:           warnings, deps
    exposed-modules:
        Noided.Sql.Migration
        Noided.Sql.Migration.Internal
    hs-source-dirs:   lib
    default-language: GHC2021

executable noided-migrate
    import:           warnings, deps
    main-is:          Main.hs
    build-depends:
        noided-sql-migrations,
        optparse-applicative,
        text,
        vector
    hs-source-dirs:   app
    default-language: GHC2021
