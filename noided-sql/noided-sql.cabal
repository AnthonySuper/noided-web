cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'noided-sql' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               noided-sql

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           Sql interface for the noided-web library

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Anthony Super

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         anthony@noided.media

-- A copyright notice.
-- copyright:
category:           Database
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

common deps
    build-depends:
        base >=4.18 && <=4.20,
        text,
        containers,
        hasql >= 1.10 && < 1.11,
        time,
        uuid,
        transformers,
        hkd,
        noided-row,
        optics-core,
        mtl,
        vector

common extensions
    default-extensions:
      DataKinds,
      TypeFamilies


library
    -- Import common warning flags.
    import:           warnings, deps, extensions

    -- Modules exported by the library.
    exposed-modules:
      Noided.Sql.Internal.Type.Columnar
      Noided.Sql.Internal.Type.ColumnName
      Noided.Sql.Internal.Type.ColumnType
      Noided.Sql.Internal.Type.HaskellT
      Noided.Sql.Internal.Type.MutationExpr
      Noided.Sql.Internal.Type.MutationType
      Noided.Sql.Internal.Type.Nullability
      Noided.Sql.Internal.Type.PGDecoder
      Noided.Sql.Internal.Type.QueryWriter
      Noided.Sql.Internal.Type.SqlExpr
      Noided.Sql.Internal.Type.SqlQuery
      Noided.Sql.Internal.Type.SqlType
      Noided.Sql.Internal.Type.Syntax
      Noided.Sql.Internal.Type.TableDefinition
      Noided.Sql.Internal.Type.TableName
      Noided.Sql.Internal.Type.Tie
      Noided.Sql.Internal.Type.TransactionResult
      Noided.Sql.Internal.Type.TransactM
      Noided.Sql.Internal.Type.WindowFrame

      Noided.Sql.Internal.Select.FromClause
      Noided.Sql.Internal.Select.SelectM
      Noided.Sql.Internal.Select.Combine

      Noided.Sql.Internal.Insert.Insert
      Noided.Sql.Internal.Insert.InsertValues

      Noided.Sql.Internal.Update.Sets
      Noided.Sql.Internal.Update.Update

      Noided.Sql.Internal.Delete.Delete

      Noided.Sql.Internal.Class.AsBindParam
      Noided.Sql.Internal.Class.AsHaskellValue
      Noided.Sql.Internal.Class.DecodeSelectList
      Noided.Sql.Internal.Class.FromItem
      Noided.Sql.Internal.Class.NamedColumns
      Noided.Sql.Internal.Class.PGType
      Noided.Sql.Internal.Class.Query
      Noided.Sql.Internal.Class.RangeOffset
      Noided.Sql.Internal.Class.SelectList
      Noided.Sql.Internal.Class.UnwrapSelectList

      Noided.Sql.Internal.SqlExpr.Bind
      Noided.Sql.Internal.SqlExpr.Bool

      Noided.Sql.Select

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.

    -- Directories containing source files.
    hs-source-dirs:   lib

    -- Base language which the package is written in.
    default-language: GHC2021

test-suite noided-sql-test
    -- Import common warning flags.
    import:           warnings, deps, extensions

    -- Base language which the package is written in.
    default-language: GHC2021

    -- Modules included in this executable, other than Main.
    other-modules:
      Noided.Sql.Internal.Type.ColumnNameSpec
      Noided.Sql.Internal.Select.SelectMSpec
      Noided.Sql.Internal.SqlExpr.BoolSpec
      Noided.Sql.Internal.Insert.InsertSpec
      Noided.Sql.Internal.Update.SetsSpec
      Noided.Sql.Internal.Update.UpdateSpec
      Noided.Sql.Internal.Delete.DeleteSpec
      Noided.Sql.Internal.Select.CombineSpec

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    build-tool-depends:
         hspec-discover:hspec-discover

    -- The entrypoint to the test suite.
    main-is:          Spec.hs

    -- Test dependencies.
    build-depends:
        noided-sql,
        hspec,
        hspec-golden
