DELETE FROM "users" AS to_delete USING "other_users" AS "other_users" CROSS JOIN "third_users" AS "third_users" WHERE ((to_delete."id") = ("other_users"."id")) AND ((to_delete."id") = ("third_users"."id")) RETURNING to_delete."id" AS "id", to_delete."name" AS "name", to_delete."email" AS "email", to_delete."score" AS "score"