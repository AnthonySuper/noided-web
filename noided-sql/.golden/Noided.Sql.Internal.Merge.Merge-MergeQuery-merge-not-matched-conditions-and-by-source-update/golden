MERGE INTO "users" AS to_merge USING "source_users" AS "source_users" ON ((to_merge."id") = ("source_users"."id")) WHEN NOT MATCHED AND (("source_users"."score") > ($1)) THEN INSERT ("name", "email", "score") VALUES ("source_users"."name", "source_users"."email", "source_users"."score") WHEN NOT MATCHED BY SOURCE AND ((to_merge."score") > ($2)) THEN UPDATE SET "score" = to_merge."score" RETURNING to_merge."id" AS "id"