cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'optimize-beer' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               optimize-beer

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            AGPL-3.0-or-later

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Anthony Super

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         anthony@noided.media

-- A copyright notice.
-- copyright:
category:           Web
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

common exts
    default-extensions:
       DerivingVia
       DeriveAnyClass
       UndecidableInstances
       TypeFamilies
       DataKinds
       OverloadedStrings
       LambdaCase
       OverloadedLabels
       TypeApplications
       OverloadedRecordDot
       AllowAmbiguousTypes

common deps
    build-depends:
      base >= 4.18 && <= 4.23,
      text,
      bytestring,
      vector,
      optics,
      optics-core,
      containers,
      http-api-data,
      time,
      resource-pool,
      hasql,
      directory,
      transformers,
      hspec,
      aeson,
      yaml,
      password,
      password-types,
      effectful,
      effectful-core,
      hkd,
      lucid2,
      http-types,
      mtl,
      wai,

      noided-form-hkd,
      noided-pathname,
      noided-form,
      noided-row,
      noided-sql,
      noided-translate,
      noided-validation,
      noided-web-html,
      noided-web

library
    -- Import common warning flags.
    import:           warnings, exts, deps

    -- Modules exported by the library.
    exposed-modules:
        OptBeer.App

        OptBeer.DB.Ids.ActorId
        OptBeer.DB.Type.PasswordDigest

        OptBeer.DB.Table.Actor
        OptBeer.DB.Table.User
        OptBeer.DB.Table.UserPassword
        OptBeer.DB.Table.Timestamps

        OptBeer.Page.Type
        OptBeer.Page.Layout
        OptBeer.Page.Error
        OptBeer.Action

        OptBeer.Error.BadRequest

        OptBeer.Effect.HashPassword
        OptBeer.Type.Hashword

        OptBeer.ValidationError.DoesNotMatchConfirmation
        OptBeer.ValidationError.ValueTaken
        OptBeer.ValidationError.PasswordComplexity
        OptBeer.Validate.Password

        OptBeer.Form.Type.CreateUser
        OptBeer.Form.Validate.CreateUser
        OptBeer.Form.Render.CreateUser
        OptBeer.Form.Render.PasswordPolicy

        OptBeer.Routes

        -- Action routes
        OptBeer.Action.User



    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:

    -- Directories containing source files.
    hs-source-dirs:   lib

    -- Base language which the package is written in.
    default-language: GHC2021

executable optimize-beer
    -- Import common warning flags.
    import:           warnings, exts, deps

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
        warp,
        optimize-beer

    ghc-options: -threaded -O2 -rtsopts -with-rtsopts=-N

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: GHC2021

test-suite optimize-beer-test
    -- Import common warning flags.
    import:           warnings, exts, deps

    -- Base language which the package is written in.
    default-language: GHC2021

    build-depends:
          tagsoup

    -- Modules included in this executable, other than Main.
    other-modules:
            OptBeer.SpecHook

            OptBeer.DB.Table.ActorSpec
            OptBeer.DB.Table.UserSpec
            OptBeer.DB.Table.UserPasswordSpec
            OptBeer.DB.Table.SpecHelper

            OptBeer.Form.Render.SpecHook
            OptBeer.Form.Render.SpecHelper
            OptBeer.Form.Render.CreateUserSpec

            OptBeer.Form.Validate.CreateUserSpec

            OptBeer.Action.SpecHook
            OptBeer.Action.SpecHelper


    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    build-tool-depends: hspec-discover:hspec-discover
    -- The entrypoint to the test suite.
    main-is:          Spec.hs

    -- Test dependencies.
    build-depends:
        optimize-beer,
        hspec
